#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|json|jsonc|css)$')

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

echo "Running Ultracite on staged files:"
echo "$STAGED_FILES"

FORMAT_EXIT_CODE=0

echo "$STAGED_FILES" | xargs pnpm dlx ultracite fix || FORMAT_EXIT_CODE=$?

echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Ultracite found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "✨ Files formatted by Ultracite"