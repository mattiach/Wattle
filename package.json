    "name": "Mattia",
    "email": "mattiach.developer@gmail.com",
    "url": "https://www.linkedin.com/in/mattiach/"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm update:tauri-version && pnpm build:tauri",
    "build:tauri": "tauri build --target x86_64-pc-windows-msvc",
    "build:web": "vite build",
    "check": "ultracite check",
    "check:notices": "python ./scripts/notices/generate-notices.py --check",
    "check:translations": "node ./scripts/check-translations.js",
    "check:versions": "node ./scripts/check-versions.js",
    "clean:tauri": "cargo clean --manifest-path ./src-tauri/Cargo.toml && node ./scripts/analyze-size.js",
    "dev": "tauri dev",
    "fix": "ultracite fix",
    "generate:notices": "python ./scripts/notices/generate-notices.py",
    "generate:previews": "node ./preview/scripts/generate-previews.js",
    "generate:themes": "node ./scripts/generate-themes.js",
    "generate:video": "node ./preview/scripts/generate-video.js",
    "generate-barrels": "barrelsby --config barrelsby.json",
    "prepare": "lefthook install",
    "tauri": "tauri",
    "update:app-version": "node ./scripts/update-app-version.js",
    "update:tauri-version": "node ./scripts/update-tauri-version.js",
    "version:bump": "pnpm version patch --no-git-tag-version && pnpm update:tauri-version && git add package.json pnpm-lock.yaml src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
