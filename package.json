    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/antic": "^5.3.0",
    "@fontsource/ar-one-sans": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
